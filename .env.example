# ========================================================
# Socmed-Buddy - Configuration (.env)
# ========================================================

# 1. Telegram Bot (Required)
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Allowed Telegram Chat IDs (comma-separated, e.g. 12345678,87654321).
# Leave blank to allow any chat during initial testing.
TELEGRAM_ALLOWED_CHAT_IDS=

# 2. Google Gemini Models (Primary LLM Engine)
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model Routing:
# - Normal Task: High-speed extraction (topic, hook, summary, signals per post)
GEMINI_NORMAL_MODEL=gemini/gemini-3.5-flash-lite

# - Specific Task: Thematic clustering, strategic insights & editorial digest synthesis
GEMINI_SPECIFIC_MODEL=gemini/gemini-3.5-flash

# 3. Social Media Data Scraping Tools & APIs
# A. YouTube Data API v3 (Google Cloud Console)
# Scrapes video metadata, statistics, duration, and descriptions via uploads playlist (quota-efficient)
YOUTUBE_API_KEY=

# B. Apify API Token (https://console.apify.com/)
# Scrapes TikTok via clockworks/tiktok-scraper actor (subtitles, metrics, video metadata)
APIFY_TOKEN=

# C. Meta Graph API v21.0 (Meta for Developers)
# Scrapes Instagram Business/Creator accounts via Business Discovery (captions, engagement metrics)
META_ACCESS_TOKEN=
IG_USER_ID=

# 4. Governance & Database
MONTHLY_BUDGET_USD=50.0
DATABASE_PATH=agentic.db
